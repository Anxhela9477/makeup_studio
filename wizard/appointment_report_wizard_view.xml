<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Appointment Report Wizard Form -->
    <record id="view_appointment_report_wizard_form"
            model="ir.ui.view">

        <field name="name">appointment.report.wizard.form</field>
        <field name="model">makeup_studio.appointment_report_wizard</field>

        <field name="arch" type="xml">
            <form string="Appointment Report">

                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>

                    <group>
                        <field name="staff_id"/>
                        <field name="status"/>
                    </group>
                </group>

                <footer>
                    <button name="action_generate_report"
                            string="Generate PDF"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>

            </form>
        </field>
    </record>

    <!-- Action to open the Wizard -->
    <record id="action_appointment_report_wizard"
            model="ir.actions.act_window">

        <field name="name">Appointment Report</field>
        <field name="res_model">makeup_studio.appointment_report_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>

    </record>

</odoo>
