<odoo>

    <!-- INVENTORY TREE VIEW -->
    <record id="view_makeup_inventory_tree" model="ir.ui.view">
        <field name="name">makeup_studio.inventory.tree</field>
        <field name="model">makeup_studio.inventory</field>
        <field name="arch" type="xml">
            <tree>
                <field name="inventory_code"/>
                <field name="product_name"/>
                <field name="category"/>
                <field name="quantity"/>
                <field name="minimum_quantity"/>
                <field name="unit_price"/>
                <field name="total_value"/>
                <field name="low_stock"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- INVENTORY FORM VIEW -->
    <record id="view_makeup_inventory_form" model="ir.ui.view">
        <field name="name">makeup_studio.inventory.form</field>
        <field name="model">makeup_studio.inventory</field>
        <field name="arch" type="xml">
            <form string="Inventory">

                <sheet>

                    <group>
                        <group>
                            <field name="inventory_code"/>
                            <field name="product_name"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="quantity"/>
                            <field name="minimum_quantity"/>
                            <field name="low_stock" readonly="1"/>
                        </group>
                    </group>

                    <group string="Price Information">
                        <field name="unit_price"/>
                        <field name="total_value" readonly="1"/>
                    </group>

                    <group string="Notes">
                        <field name="notes"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- INVENTORY ACTION -->
    <record id="action_makeup_inventory" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">makeup_studio.inventory</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>