<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <!-- DISCOUNT LIST VIEW -->
        <record id="discount_tree_view" model="ir.ui.view">
            <field name="name">makeup_studio.discount.tree</field>
            <field name="model">makeup_studio.discount</field>

            <field name="arch" type="xml">
                <tree string="Discounts">

                    <field name="name"/>

                    <field name="minimum_points"/>

                    <field name="discount_amount"/>

                    <field name="active"/>

                </tree>
            </field>
        </record>


        <!-- DISCOUNT FORM VIEW -->
        <record id="discount_form_view" model="ir.ui.view">
            <field name="name">makeup_studio.discount.form</field>
            <field name="model">makeup_studio.discount</field>

            <field name="arch" type="xml">
                <form string="Discount">

                    <sheet>

                        <group string="Discount Information">

                            <field name="name"/>

                            <field name="minimum_points"/>

                            <field name="discount_amount"/>

                            <field name="active"/>

                        </group>

                    </sheet>

                </form>
            </field>
        </record>


        <!-- DISCOUNT ACTION -->
        <record id="action_makeup_discount"
                model="ir.actions.act_window">

            <field name="name">Discounts</field>

            <field name="res_model">makeup_studio.discount</field>

            <field name="view_mode">tree,form</field>

        </record>

    </data>
</odoo>